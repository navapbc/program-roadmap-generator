# Copy this file to `.env` at the repository root, then edit as needed.
# `npm run setup` does the copy for you. This single file configures both
# the API and the web app.

# Where the local database file lives. The path is relative to
# apps/server/prisma/, so the default resolves to apps/server/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Port the API listens on.
API_PORT=4000

# Port the web app is served from. This is the address you open in a browser.
# The web app forwards API calls to API_PORT above, so changing either port
# here is all that is needed to run a second copy alongside an existing one.
WEB_PORT=5173
