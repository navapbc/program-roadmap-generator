generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                       String    @id @default(cuid())
  name                     String
  description              String?
  startDate                DateTime?
  defaultSizingKeyId       String?
  timelineHeaderScales     String    @default("[\"month\",\"week\"]")
  // Both set or both null — enforced in project.update, not here (SQLite
  // CHECK constraints can't express "both or neither" as cleanly as a
  // simple predicate on their own, and it's already validated via Zod).
  // 0=Sunday..6=Saturday, matching Date#getUTCDay().
  sprintLengthBusinessDays Int?
  sprintStartWeekday       Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  defaultSizingKey   SizingKey?          @relation(fields: [defaultSizingKeyId], references: [id], onDelete: SetNull)
  sizeLabels         SizeLabel[]
  milestones         Milestone[]
  markers            TimelineMarker[]
  combinedViewScopes CombinedViewScope[]
}

/// A single named point in time (e.g. "Target launch") shown as a vertical line on the Timeline.
model TimelineMarker {
  id        String   @id @default(cuid())
  projectId String
  label     String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SizeLabel {
  id         String @id @default(cuid())
  projectId  String
  code       String
  orderIndex Int

  project                     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiativesAsPolicy         Initiative[] @relation("InitiativePolicySize")
  initiativesAsImplementation Initiative[] @relation("InitiativeImplementationSize")

  @@unique([projectId, code])
  @@unique([projectId, orderIndex])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  orderKey    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  increments         Increment[]
  combinedViewScopes CombinedViewScope[]

  @@index([projectId])
}

model Increment {
  id          String   @id @default(cuid())
  milestoneId String
  name        String
  description String?
  orderKey    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestone          Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  initiatives        Initiative[]
  combinedViewScopes CombinedViewScope[]

  @@index([milestoneId])
}

model Initiative {
  id                        String   @id @default(cuid())
  incrementId               String
  name                      String
  orderKey                  String
  policySizeLabelId         String?
  implementationSizeLabelId String?
  timeEstimateWeeks         Float?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  increment               Increment  @relation(fields: [incrementId], references: [id], onDelete: Cascade)
  policySizeLabel         SizeLabel? @relation("InitiativePolicySize", fields: [policySizeLabelId], references: [id], onDelete: SetNull)
  implementationSizeLabel SizeLabel? @relation("InitiativeImplementationSize", fields: [implementationSizeLabelId], references: [id], onDelete: SetNull)

  @@index([incrementId])
}

model SizingKey {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Max number of initiatives that may be actively in progress at once,
  // regardless of phase. Safe to default above 1 for existing keys: while
  // every phase is non-overlapping (today's default), the shared exclusive
  // lock in computeTimeline() dominates this cap and the schedule stays
  // fully sequential until a phase is explicitly marked overlap-capable.
  maxOverlap  Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels             SizingKeyLabel[]
  phases             SizingPhase[]
  projects           Project[]
  combinedViewScopes CombinedViewScope[]
}

model SizingKeyLabel {
  id          String @id @default(cuid())
  sizingKeyId String
  code        String
  orderIndex  Int

  sizingKey SizingKey @relation(fields: [sizingKeyId], references: [id], onDelete: Cascade)

  @@unique([sizingKeyId, code])
  @@unique([sizingKeyId, orderIndex])
}

model SizingPhase {
  id          String  @id @default(cuid())
  sizingKeyId String
  name        String
  // 'day' | 'week' | 'month' — plain string + app-level Zod validation
  // rather than a Prisma enum, kept consistent with the mutual-exclusivity
  // CHECK constraint pattern used elsewhere for SQLite.
  unit        String
  orderIndex  Int
  // When false (default), this phase holds a shared exclusive lock in
  // computeTimeline() — only one initiative may be inside it at a time,
  // across the whole schedule. When true, it holds no lock and other
  // initiatives may run in any phase at the same time.
  canOverlap  Boolean @default(false)

  sizingKey SizingKey        @relation(fields: [sizingKeyId], references: [id], onDelete: Cascade)
  durations SizingDuration[]

  @@unique([sizingKeyId, orderIndex])
}

model SizingDuration {
  id            String @id @default(cuid())
  sizingPhaseId String
  labelCode     String
  durationValue Float

  sizingPhase SizingPhase @relation(fields: [sizingPhaseId], references: [id], onDelete: Cascade)

  @@unique([sizingPhaseId, labelCode])
}

/// A saved Combined Timeline configuration — a named set of scopes (one row
/// per project/milestone/increment/sizing-key selection) plus the header
/// scales and optional date-range window the user had configured, so the
/// whole comparison can be reopened later instead of rebuilt from scratch.
model CombinedView {
  id                   String    @id @default(cuid())
  name                 String
  timelineHeaderScales String    @default("[\"month\",\"week\"]")
  dateRangeStart       DateTime?
  dateRangeEnd         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  scopes CombinedViewScope[]
}

/// One row/scope within a saved Combined View. milestoneId/incrementId null
/// means "whole project" / "whole milestone" respectively — incrementId is
/// only meaningful once milestoneId narrows to a specific milestone.
/// startDateOverride is a view-only "modeling" start date used when this
/// scope's own project has no real start date but needs to be plotted
/// alongside an anchored one — it's never written back to the Project.
model CombinedViewScope {
  id                String    @id @default(cuid())
  combinedViewId    String
  projectId         String
  milestoneId       String?
  incrementId       String?
  sizingKeyId       String
  startDateOverride DateTime?
  orderKey          String

  combinedView CombinedView @relation(fields: [combinedViewId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  increment    Increment?   @relation(fields: [incrementId], references: [id], onDelete: SetNull)
  sizingKey    SizingKey    @relation(fields: [sizingKeyId], references: [id], onDelete: Cascade)

  @@index([combinedViewId])
  @@index([projectId])
}
